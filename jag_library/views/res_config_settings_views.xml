<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_library" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.jag.library</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_settings']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="library_blog_settings">
                    <div class="o_setting_left_pane" />
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">JAG Library</span>
                        <div class="text-muted">
                            Set the default blog for publishing book reviews.
                        </div>
                        <div class="content-group mt16">
                            <div class="row mt16">
                                <label for="blog_id" class="col-lg-4 o_light_label" />
                                <field name="blog_id" />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
