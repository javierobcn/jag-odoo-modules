<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_blog_post_form_inherit_cover_properties" model="ir.ui.view">
    <field name="name">blog.post.form.inherit.cover.properties</field>
    <field name="model">blog.post</field>
    <field name="inherit_id" ref="website_blog.view_blog_post_form" />
    <field name="arch" type="xml">
      <xpath expr="//group[@name='publishing_details']" position="inside">
        <field name="cover_properties" widget="text" />
      </xpath>
    </field>
  </record>
</odoo>
